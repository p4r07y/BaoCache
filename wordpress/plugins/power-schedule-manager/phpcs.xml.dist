<?xml version="1.0"?>
<ruleset name="Cúp Điện Lâm Đồng">
	<description>WordPress and PHP 8.5 coding standards.</description>
	<file>power-schedule-manager.php</file>
	<file>includes</file>
	<file>admin</file>
	<file>public</file>
	<exclude-pattern>public/assets/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP">
		<config name="testVersion" value="8.5-"/>
	</rule>
	<config name="minimum_supported_wp_version" value="6.7"/>
</ruleset>
